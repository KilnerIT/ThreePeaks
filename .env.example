# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="AIzaSyC-NQ2QiEosuVRYaZQtokq9L_tw14dD5fM"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# APP_PASSWORD: The simple password to secure the page (e.g. "peaks24")
APP_PASSWORD="peaks"

# HOME_ASSISTANT_URL: The remote access URL for Home Assistant
HOME_ASSISTANT_URL="https://7vb1ticrsq5avd8cvispf0gfrhzx8v7a.ui.nabu.casa"

# HOME_ASSISTANT_TOKEN: Bearer token / Long-Lived Access Token for Home Assistant
HOME_ASSISTANT_TOKEN="YOUR_LONG_LIVED_ACCESS_TOKEN"

# HA_GPS_ENTITY_ID: Entity ID for GPS coordinates tracking (e.g., "device_tracker.wayne_phone")
HA_GPS_ENTITY_ID="device_tracker.wayne"

# HA_STEPS_ENTITY_ID: Entity ID for step counts (e.g., "sensor.wayne_steps" or "sensor.peaks_steps")
HA_STEPS_ENTITY_ID="sensor.wayne_steps"
